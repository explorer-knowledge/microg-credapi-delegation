+import android.app.Activity
+import androidx.annotation.RequiresApi
+import androidx.credentials.CreatePublicKeyCredentialRequest
+import androidx.credentials.CreatePublicKeyCredentialResponse
+import androidx.credentials.CredentialManager
+import androidx.credentials.GetCredentialRequest
+import androidx.credentials.GetPublicKeyCredentialOption
+import androidx.credentials.PublicKeyCredential
+import com.google.android.gms.fido.fido2.api.common.PublicKeyCredentialDescriptor
+import com.google.android.gms.fido.fido2.api.common.PublicKeyCredentialUserEntity
+import org.json.JSONArray
+import org.json.JSONObject
+import org.microg.gms.fido.core.protocol.AttestationObject
+import org.microg.gms.fido.core.protocol.msgs.AuthenticatorGetAssertionRequest
+import org.microg.gms.fido.core.protocol.msgs.AuthenticatorGetAssertionResponse
+import org.microg.gms.fido.core.protocol.msgs.AuthenticatorMakeCredentialRequest
+import org.microg.gms.fido.core.protocol.msgs.AuthenticatorMakeCredentialResponse
+import java.util.Base64
+
+/**
+ * Delegates hybrid (caBLE) CTAP2 requests to the Android system Credential Manager, so that
+ * third-party credential providers are used. The PC's clientDataHash and the RP origin are passed
+ * through, which Credential Manager only accepts for privileged callers
+ * (CREDENTIAL_MANAGER_SET_ORIGIN); otherwise it throws and the caller falls back to microG's vault.
+ */
+@RequiresApi(26) // java.util.Base64 (JVM-testable); only called on API 34+
+object CredentialManagerBridge {
+    private fun ByteArray.b64() = Base64.getUrlEncoder().withoutPadding().encodeToString(this)
+    private fun String.unb64() = Base64.getUrlDecoder().decode(this)
+
+    private fun PublicKeyCredentialDescriptor.json() = JSONObject().put("type", typeAsString).put("id", id.b64())
+
+    internal fun createRequestJson(request: AuthenticatorMakeCredentialRequest): String {
+        val rk = request.options?.residentKey == true
+        return JSONObject()
+            .put("rp", JSONObject().put("id", request.rp.id).put("name", request.rp.name))
+            .put("user", JSONObject().put("id", request.user.id.b64()).put("name", request.user.name).put("displayName", request.user.displayName))
+            .put("challenge", request.clientDataHash.b64())
+            .put("pubKeyCredParams", JSONArray(request.pubKeyCredParams.map { JSONObject().put("type", it.typeAsString).put("alg", it.algorithmIdAsInteger) }))
+            .put("excludeCredentials", JSONArray(request.excludeList.map { it.json() }))
+            .put("authenticatorSelection", JSONObject()
+                .put("residentKey", if (rk) "required" else "discouraged")
+                .put("requireResidentKey", rk)
+                .put("userVerification", if (request.options?.userVerification == true) "required" else "preferred"))
+            .put("attestation", "none")
+            .toString()
+    }
+
+    internal fun parseRegistration(json: String): AuthenticatorMakeCredentialResponse {
+        val attObj = AttestationObject.decode(JSONObject(json).getJSONObject("response").getString("attestationObject").unb64())
+        return AuthenticatorMakeCredentialResponse(attObj.authData, attObj.fmt, attObj.attStmt)
+    }
+
+    internal fun getRequestJson(request: AuthenticatorGetAssertionRequest): String = JSONObject()
+        .put("rpId", request.rpId)
+        .put("challenge", request.clientDataHash.b64())
+        .put("allowCredentials", JSONArray(request.allowList.map { it.json() }))
+        .put("userVerification", if (request.options?.userVerification == true) "required" else "preferred")
+        .toString()
+
+    internal fun parseAssertion(json: String): AuthenticatorGetAssertionResponse {
+        val obj = JSONObject(json)
+        val resp = obj.getJSONObject("response")
+        val userHandle = resp.optString("userHandle").takeIf { it.isNotEmpty() }?.unb64()
+        return AuthenticatorGetAssertionResponse(
+            credential = PublicKeyCredentialDescriptor("public-key", obj.getString("rawId").unb64(), null),
+            authData = resp.getString("authenticatorData").unb64(),
+            signature = resp.getString("signature").unb64(),
+            user = userHandle?.let { PublicKeyCredentialUserEntity(it, "", null, "") },
+            numberOfCredentials = 1
+        )
+    }
+
+    suspend fun create(activity: Activity, request: AuthenticatorMakeCredentialRequest): AuthenticatorMakeCredentialResponse {
+        val response = CredentialManager.create(activity).createCredential(
+            activity,
+            CreatePublicKeyCredentialRequest(createRequestJson(request), request.clientDataHash, false, "https://${request.rp.id}")
+        ) as CreatePublicKeyCredentialResponse
+        return parseRegistration(response.registrationResponseJson)
+    }
+
+    suspend fun get(activity: Activity, request: AuthenticatorGetAssertionRequest): AuthenticatorGetAssertionResponse {
+        val result = CredentialManager.create(activity).getCredential(
+            activity,
+            GetCredentialRequest(listOf(GetPublicKeyCredentialOption(getRequestJson(request), request.clientDataHash)), "https://${request.rpId}")
+        )
+        val cred = result.credential as? PublicKeyCredential ?: throw RuntimeException("Not a public key credential")
+        return parseAssertion(cred.authenticationResponseJson)
+    }
+}
