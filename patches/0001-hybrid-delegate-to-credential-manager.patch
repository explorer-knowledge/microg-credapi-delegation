+/**
+ * SPDX-FileCopyrightText: 2025 microG Project Team
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.microg.gms.fido.core.ui.hybrid
+
+import com.google.android.gms.fido.fido2.api.common.PublicKeyCredentialDescriptor
+import com.upokecenter.cbor.CBORObject
+import org.json.JSONObject
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Test
+import org.microg.gms.fido.core.protocol.msgs.AuthenticatorGetAssertionRequest
+import java.util.Base64
+
+class CredentialManagerBridgeTest {
+    private fun b64(b: ByteArray) = Base64.getUrlEncoder().withoutPadding().encodeToString(b)
+    private val hash = ByteArray(32) { it.toByte() }
+    private val credId = byteArrayOf(-1, 0, 1, 62, 63) // bytes that differ between base64 and base64url
+
+    @Test
+    fun getRequestJson_encodesHashAndAllowListAsBase64Url() {
+        val json = JSONObject(CredentialManagerBridge.getRequestJson(
+            AuthenticatorGetAssertionRequest("example.com", hash, listOf(PublicKeyCredentialDescriptor("public-key", credId, null)))
+        ))
+        assertEquals("example.com", json.getString("rpId"))
+        assertEquals(b64(hash), json.getString("challenge"))
+        assertEquals(b64(credId), json.getJSONArray("allowCredentials").getJSONObject(0).getString("id"))
+    }
+
+    @Test
+    fun parseAssertion_mapsProviderJsonToCtapResponse() {
+        val authData = byteArrayOf(1, 2, 3)
+        val sig = byteArrayOf(4, 5, 6)
+        val user = byteArrayOf(7, 8)
+        val json = JSONObject()
+            .put("id", b64(credId)).put("rawId", b64(credId)).put("type", "public-key")
+            .put("response", JSONObject()
+                .put("authenticatorData", b64(authData)).put("signature", b64(sig)).put("userHandle", b64(user)))
+            .toString()
+        val r = CredentialManagerBridge.parseAssertion(json)
+        assertArrayEquals(credId, r.credential!!.id)
+        assertArrayEquals(authData, r.authData)
+        assertArrayEquals(sig, r.signature)
+        assertArrayEquals(user, r.user!!.id)
+    }
+
+    @Test
+    fun parseRegistration_decodesAttestationObject() {
+        val authData = byteArrayOf(9, 8, 7)
+        val attObj = CBORObject.NewMap().apply {
+            set("fmt", CBORObject.FromObject("none"))
+            set("authData", CBORObject.FromObject(authData))
+            set("attStmt", CBORObject.NewMap())
+        }.EncodeToBytes()
+        val json = JSONObject().put("response", JSONObject().put("attestationObject", b64(attObj))).toString()
+        val r = CredentialManagerBridge.parseRegistration(json)
+        assertArrayEquals(authData, r.authData)
+        assertEquals("none", r.fmt)
+    }
+}
