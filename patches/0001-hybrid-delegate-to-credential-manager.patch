+    // Prefer the system Credential Manager (third-party providers); fall back to microG's own vault unless the user cancelled.
+    private suspend fun <T> viaCredentialManager(call: suspend () -> T): T? {
+        return try {
+            call()
+        } catch (e: kotlinx.coroutines.CancellationException) {
+            throw e
+        } catch (e: CreateCredentialCancellationException) {
